# bsl-agent-mcp configuration. Copy to .env (same directory) and fill in.
# A variable set in the process environment overrides the value here.

# EVM private key the server pays from (keep this file private)
AGENT_PRIVATE_KEY=0x...

# Subnet IDs (from the BSL operator)
SUBNET_ID=/b4/...
SUBNET2_ID=/b4/...

# Client access key (gateway bearer + provider auth)
API_TOKEN=...

# Per-operation spending cap in satoshis (over-cap needs user approval)
SPEND_CAP_SATS=500000
